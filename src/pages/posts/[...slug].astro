---
import { getPublished, isReservedSlug } from '../../lib/content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPublished('posts', {
    orderBy: (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  });
  const visiblePosts = posts.filter((entry) => !isReservedSlug(entry.data.slug ?? entry.id));
  return visiblePosts.map((entry) => {
    const slug = entry.data.slug ?? entry.id;
    return {
      params: { slug },
      props: { slug }
    };
  });
}

return Astro.redirect(
  `${(import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/')}archive/${Astro.params.slug}/`,
  301
);
---
