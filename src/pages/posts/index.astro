---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import EssayCard from '../../components/EssayCard.astro';
import { createWithBase, getPostSlug, getPageSlice, getTotalPages, getVisiblePosts } from '../../lib/content';
import { getThemeSettings } from '../../lib/theme-settings';
import { getListExcerpt } from '../../utils/excerpt';
import { joinPageSubtitleText } from '../../utils/format';
import { PAGE_SIZE_ESSAY } from '../../../site.config.mjs';

const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);
const {
  settings: {
    page
  }
} = getThemeSettings();
const visiblePosts = await getVisiblePosts();
const totalPages = getTotalPages(visiblePosts.length, PAGE_SIZE_ESSAY);
const currentPage = 1;
const pagePosts = getPageSlice(visiblePosts, currentPage, PAGE_SIZE_ESSAY);
const showPagination = totalPages > 1;
const prevHref = null;
const nextHref = currentPage < totalPages ? withBase(`/posts/page/${currentPage + 1}/`) : null;
const pageTitleText = page.posts.title || '文章';
const subtitleText = joinPageSubtitleText(page.posts.subtitle, `共 ${visiblePosts.length} 篇`);
---

<BaseLayout title={pageTitleText} bodyClass="posts-page">
  <div class="page-header page-header--posts page-header--with-search">
    <div class="page-heading">
      <h1 class="page-title">{pageTitleText}</h1>
      <span class="page-subtitle">
        {subtitleText ? `${subtitleText} · ` : null}
        <a href={withBase('/posts/rss.xml')}>RSS</a>
      </span>
    </div>
    <div class="page-actions">
      <div class="entry-search" data-entry-search data-index-url="/posts/index.json">
        <div class="entry-search-panel" data-entry-search-panel aria-hidden="true">
          <input
            data-entry-search-input
            type="search"
            placeholder="搜索：标题 / 摘要 / 标签"
            autocomplete="off"
            aria-label={`搜索${pageTitleText}`}
          />
        </div>
        <button
          class="entry-search-toggle"
          data-entry-search-toggle
          type="button"
          aria-label={`搜索${pageTitleText}`}
          title="搜索"
          aria-expanded="false"
        >
          <Icon name="search" class="icon" />
        </button>
      </div>
    </div>
  </div>
  <div class="entry-status" data-entry-search-status role="status" aria-live="polite"></div>

  <div class="list">
    {pagePosts.map((e) => (
      <EssayCard
        href={withBase(`/archive/${getPostSlug(e)}/`)}
        slug={getPostSlug(e)}
        title={e.data.title}
        excerpt={getListExcerpt(e)}
        date={e.data.date}
        tag={e.data.tags?.[0]}
        badge={e.data.badge}
      />
    ))}
  </div>

  {showPagination && (
    <nav class="pagination" aria-label={`${pageTitleText}分页`}>
      <div class="pagination__inner">
        {prevHref ? (
          <a class="pagination__link" rel="prev" href={prevHref}>上一页</a>
        ) : null}
        {nextHref ? (
          <a class="pagination__link pagination__link--next" rel="next" href={nextHref}>下一页</a>
        ) : null}
      </div>
    </nav>
  )}

  <script>
    import '../../scripts/entry-search.ts';
  </script>
</BaseLayout>
