---
import { formatISODate } from '../utils/format';

const {
  href,
  title,
  excerpt,
  date,
  tags = []
} = Astro.props;
---

<a class="list-item list-item--link" href={href}>
  <div class="list-item__row">
    <h3 class="list-item__title">{title}</h3>
  </div>
  {excerpt ? <p class="list-item__excerpt">{excerpt}</p> : null}
  <div class="meta-line">{formatISODate(date)}{tags.length > 0 ? <>{' · '}{tags.map((t: string, i: number) => <Fragment key={t}><span class="tag">#{t}</span>{i < tags.length - 1 ? ' ' : ''}</Fragment>)}</> : null}</div>
</a>
