---
import { formatISODate } from '../utils/format';

const {
  href,
  title,
  excerpt,
  date,
  tags = [],
  badge = '文章',
  slug = ''
} = Astro.props;

const base = import.meta.env.BASE_URL ?? '/';
const displayBadge = badge?.trim() ? badge : '文章';
---

<a class="list-item list-item--link" href={href} data-entry-item data-slug={slug || undefined}>
  <div class="list-item__row">
    <div style="display:flex; align-items:center; gap:10px;">
      <span class="badge">{displayBadge}</span>
      <h3 class="list-item__title" style="margin:0;">{title}</h3>
    </div>
  </div>
  {excerpt ? <p class="list-item__excerpt">{excerpt}</p> : null}
  <div class="meta-line">发布于：{formatISODate(date)}{tags.length > 0 ? <>{' · '}{tags.map((t: string, i: number) => <Fragment key={t}><span class="tag">#{t}</span>{i < tags.length - 1 ? ' ' : ''}</Fragment>)}</> : null}</div>
</a>
